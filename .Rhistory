x <- x %>%
mutate(
pay_rent = case_when(
str_to_lower(pay_rent) %in% c("yes","y") ~ "Yes",
str_to_lower(pay_rent) %in% c("no","n")  ~ "No",
TRUE ~ NA_character_
),
pay_rent = factor(pay_rent, levels = c("No","Yes"))
)
table(x$pay_rent)
table(x$trimester_or_semester)
x <- x%>%
mutate(
term = case_when(
str_to_lower(trimester_or_semester) %in% c("semester","sem","s") ~ "Semester",
str_to_lower(trimester_or_semester) %in% c("trimester","tri","t") ~ "Trimester",
TRUE ~ NA_character_
),
term = factor(term, levels = c("Semester","Trimester"))
)
table(x$term)
table(x$assignment_preference)
x <- x %>%
mutate(
assignment_preference_raw   = assignment_preference,
assignment_preference_clean = case_when(
str_detect(str_to_lower(str_squish(assignment_preference_raw)), "immed")           ~ "Immediate",
str_detect(str_to_lower(str_squish(assignment_preference_raw)), "plan")            ~ "Planned",
str_detect(str_to_lower(str_squish(assignment_preference_raw)), "cram|last|dead") ~ "Cram",
TRUE ~ NA_character_
),
assignment_preference_clean = factor(assignment_preference_clean,
levels = c("Immediate","Planned","Cram")),
)
table(x$assignment_preference)
g3 <- ggplot(x, aes(x = assignment_preference)) +
geom_bar(fill = "slategray1") +
scale_x_discrete(labels = c("do them immediately" = "Immediately",
"draw up a schedule and work through it in planned stages" = "Planned",
"cram at the last second" = "Cram")) +
labs(
title = "Assignment Preference",
x = "Preference",
y = "Count"
) +
theme_minimal()
print(g3)
summary(x$weekly_study_hours)
x <- x %>%
mutate(
weekly_study_hours = suppressWarnings(as.numeric(weekly_study_hours))
)
summary(x$weekly_study_hours)
g4 <- ggplot(x, aes(y = weekly_study_hours)) +
geom_boxplot(fill = "slategray1",
color = "slategray4",
outlier.colour = "steelblue") +
labs(
title = "Weekly Study Hours",
y = "Study Hours"
) +
theme_minimal()
print(g4)
table(x$believe_in_aliens)
library(dplyr)
library(stringr)
library(readr)
x <- x %>%
mutate(
believe_in_aliens = case_when(
str_to_lower(believe_in_aliens) %in% c("yes","y") ~ "Yes",
str_to_lower(believe_in_aliens) %in% c("no","n")  ~ "No",
TRUE ~ NA_character_
),
believe_in_aliens = factor(believe_in_aliens, levels = c("No","Yes")),
)
table(x$believe_in_aliens)
summary(x$daily_short_video_time)
x <- x %>%
mutate(
video_raw = str_to_lower(str_squish(daily_short_video_time)),
video_minutes = case_when(
str_detect(video_raw, "h") & str_detect(video_raw, "m") ~
as.numeric(str_extract(video_raw, "\\d+(?=h)")) * 60 +
as.numeric(str_extract(video_raw, "\\d+(?=m)")),
str_detect(video_raw, "\\d+-\\d+") & str_detect(video_raw, "hour") ~
(as.numeric(str_extract(video_raw, "\\d+(?=-)")) +
as.numeric(str_extract(video_raw, "(?<=-)\\d+"))) / 2 * 60,
str_detect(video_raw, "\\d+-\\d+") & str_detect(video_raw, "min") ~
(as.numeric(str_extract(video_raw, "\\d+(?=-)")) +
as.numeric(str_extract(video_raw, "(?<=-)\\d+"))) / 2,
str_detect(video_raw, "hour|hr|hrs|h") ~ parse_number(video_raw) * 60,
str_detect(video_raw, "min") ~ parse_number(video_raw),
str_detect(video_raw, "sec|s") ~ parse_number(video_raw) / 60,
str_detect(video_raw, "^\\d+\\.?\\d*$") ~ as.numeric(video_raw),
TRUE ~ NA_real_
)
)
summary(x$video_minutes)
p_full <- ggplot(x, aes(video_minutes)) +
geom_histogram(binwidth = 10, fill = "lightblue", color = "white") +
labs(title = "Daily short video time (minutes) — full range",
x = "Minutes/day", y = "Count") +
theme_minimal()
p_full
na_before <- sapply(x, function(col) sum(is.na(col)))
all_clean <- x %>% tidyr::drop_na()
na_after <- sapply(all_clean, function(col) sum(is.na(col)))
na_summary <- data.frame(
Variable = names(na_before),
Missing_before = na_before,
Missing_after = na_after
)
na_summary
library(dplyr)
dat_chi <- x %>%
select(pay_rent, term) %>%
tidyr::drop_na()
(ct <- table(dat_chi$pay_rent, dat_chi$term))
chi_try <- suppressWarnings(chisq.test(ct, correct = FALSE))
min_expected <- min(chi_try$expected)
chi_try$expected
if (min_expected < 5) {
message(sprintf("Min expected count = %.2f < 5 → Use Fisher's exact test.", min_expected))
test1 <- fisher.test(ct)
method_used <- "Fisher's Exact Test"
} else {
message(sprintf("Min expected count = %.2f ≥ 5 → Use Chi-square test.", min_expected))
test1 <- chi_try
method_used <- "Pearson's Chi-squared Test"
}
test1
library(scales)
library(glue)
subtxt <- glue("{method_used}: X² = {round(test1$statistic, 2)}, df = {test1$parameter}, p = {pvalue(test1$p.value)}")
p_chi_props <- ggplot(dat_chi, aes(x = term, fill = pay_rent)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Pay Rent vs Term — Proportions",
subtitle = subtxt,
x = "Term Preference",
y = "Proportion",
fill = "Pay Rent"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 15, hjust = 1)) +
scale_fill_manual(values = c("Yes" = "mistyrose", "No" = "slategray1"))
p_chi_props
library(dplyr)
library(stringr)
library(forcats)
x <- x %>%
mutate(
ap_clean = case_when(
str_detect(str_to_lower(str_squish(assignment_preference)), "cram") ~ "Cram",
str_detect(str_to_lower(str_squish(assignment_preference)), "immed") ~ "Immediate",
str_detect(str_to_lower(str_squish(assignment_preference)), "plan") ~ "Planned",
TRUE ~ NA_character_
),
ap_clean = factor(ap_clean, levels = c("Immediate","Planned","Cram")),
ap2 = case_when(
ap_clean %in% c("Immediate","Planned") ~ "Not Cram",
ap_clean == "Cram" ~ "Cram",
TRUE ~ NA_character_
),
ap2 = factor(ap2, levels = c("Not Cram","Cram"))
)
table(x$ap2)
library(dplyr)
dat_two <- x %>%
select(ap2, weekly_study_hours) %>%
tidyr::drop_na() %>%
filter(weekly_study_hours != 170)
tt <- t.test(weekly_study_hours ~ ap2, data = dat_two, var.equal = FALSE)
t_est <- unname(diff(rev(tt$estimate)))
t_ci  <- tt$conf.int
t_df  <- as.numeric(tt$parameter)
t_t   <- as.numeric(tt$statistic)
t_p   <- as.numeric(tt$p.value)
c(
mean_diff = round(t_est, 2),
ci_lo = round(t_ci[1], 2),
ci_hi = round(t_ci[2], 2),
t = round(t_t, 2),
df = round(t_df, 1),
p = format(tt$p.value, scientific = FALSE, digits = 4)
)
library(glue)
glue(
"\nalternative hypothesis: \"True difference in means between group No Cram and group Cram is not equale, {tt$alternative}\".",
"\nWelch two-sample t-test (NotCram vs Cram): ",
"mean difference = {round(t_est, 2)} h/week; ",
"\n95% Confidence Interval: [{round(t_ci[1], 2)}, {round(t_ci[2], 2)}]; ",
"\nt({round(t_df, 1)}) = {round(t_t, 2)}, p = {scales::pvalue(t_p)} "
)
library(dplyr)
library(ggplot2)
t_text <- glue("Welch Two-Sample t-test: t = {round(tt$statistic, 2)}, df = {round(tt$parameter,1)}, p = {round(tt$p.value, 5)}")
p_t_box <- ggplot(dat_two, aes(x = ap2, y = weekly_study_hours)) +
geom_boxplot(fill = "mistyrose",
color = "lightpink3",
outlier.colour = "hotpink3") +
labs(title = "Weekly Study Hours — NotCram vs Cram",
subtitle = t_text,
x = "Assignment Preference (collapsed)",
y = "Hours/week") +
theme_minimal()
p_t_box
p_t_mean_ci <- ggplot(dat_two, aes(x = ap2, y = weekly_study_hours)) +
stat_summary(fun = mean, geom = "point", size = 2) +
stat_summary(fun.data = mean_cl_normal, geom = "errorbar", width = 0.18) +
labs(title = "Mean Weekly Study Hours with 95% CI",
subtitle = t_text,
x = "Assignment Preference (collapsed)",
y = "Hours/week") +
theme_minimal()
p_t_mean_ci
set.seed(2902)
B <- 10000
library(dplyr)
dat_perm <- x %>%
filter(believe_in_aliens %in% c("Yes","No"),
!is.na(video_minutes))
obs_diff <- with(dat_perm,
mean(video_minutes[believe_in_aliens == "Yes"]) -
mean(video_minutes[believe_in_aliens == "No"]))
set.seed(2902)
B <- 10000
perm_diff <- replicate(B, {
shuffled <- sample(dat_perm$believe_in_aliens)
mean(dat_perm$video_minutes[shuffled == "Yes"]) -
mean(dat_perm$video_minutes[shuffled == "No"])
})
p_perm <- mean(abs(perm_diff) >= abs(obs_diff))
c(observed_difference = obs_diff, p_value = p_perm)
hist(perm_diff, breaks = 40,
col = "slategray1",
border = "slategray3",
main = "Permutation null distribution\n(Mean difference: Yes - No)",
xlab = "Difference in mean video minutes")
abline(v = obs_diff, col = "hotpink1", lwd = 2)
