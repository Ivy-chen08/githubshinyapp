dices <- c(1, 2, 3, 4, 5, 6)
n <- length(dices)
B <- 200
set.seed(123)
bootstrap_means <- numeric(B)
for (i in 1:B) {
resample <- sample(dices, size = n, replace = TRUE)
bootstrap_means[i] <- mean(resample)
}
bootstrap_estimate <- mean(bootstrap_means)
ci <- quantile(bootstrap_means, probs = c(0.025, 0.975))
cat("Bootstrap estimate of mean:", bootstrap_estimate, "\n")
cat("95% Bootstrap CI for population mean:", ci[1], "to", ci[2], "\n")
